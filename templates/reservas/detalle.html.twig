{% extends 'base.html.twig' %}

{% block titulo %}Detalle de la reserva #{{ reserva.id }}{% endblock %}

{% block contenido %}
  <div class="detalle-cabecera">
    <div>
      <p class="detalle-cabecera__etiqueta">Gestión de reservas</p>
      <h2>Reserva #{{ reserva.id }}</h2>
    </div>
  </div>

  <p
    id="mensaje"
    class="mensaje"
    role="status"
    aria-live="polite"
    hidden
  ></p>

  <section class="detalle" aria-labelledby="titulo-datos">
    <div class="detalle__encabezado">
      <h3 id="titulo-datos">Datos de la reserva</h3>

      <span
        id="estado-reserva"
        class="estado estado--{{ reserva.estado }}"
      >
        {{ reserva.estado|capitalize }}
      </span>
    </div>

    <dl class="detalle__datos">
      <div class="detalle__campo">
        <dt>Huésped</dt>
        <dd>{{ reserva.nombre_huesped }}</dd>
      </div>

      <div class="detalle__campo">
        <dt>Email</dt>
        <dd>{{ reserva.email_huesped }}</dd>
      </div>

      <div class="detalle__campo">
        <dt>Alojamiento</dt>
        <dd>{{ reserva.alojamiento }}</dd>
      </div>

      <div class="detalle__campo">
        <dt>Personas</dt>
        <dd>{{ reserva.num_personas }}</dd>
      </div>

      <div class="detalle__campo">
        <dt>Entrada</dt>
        <dd>{{ reserva.fecha_entrada|date('d/m/Y') }}</dd>
      </div>

      <div class="detalle__campo">
        <dt>Salida</dt>
        <dd>{{ reserva.fecha_salida|date('d/m/Y') }}</dd>
      </div>

      <div class="detalle__campo">
        <dt>Importe total</dt>
        <dd class="detalle__importe">
          {{ reserva.importe_total|number_format(2, ',', '.') }} €
        </dd>
      </div>

      <div class="detalle__campo">
        <dt>Fecha de creación</dt>
        <dd>{{ reserva.fecha_creacion|date('d/m/Y H:i') }}</dd>
      </div>

      <div class="detalle__campo detalle__campo--completo">
        <dt>Notas</dt>
        <dd class="detalle__notas">
          {{ reserva.notas ?: 'Sin notas' }}
        </dd>
      </div>
    </dl>

    {% if reserva.estado == 'pendiente' %}
      <div class="detalle__acciones">
        <button
          type="button"
          class="boton-cancelar"
          data-id="{{ reserva.id }}"
        >
          Cancelar reserva
        </button>
      </div>
    {% endif %}
  </section>

  <section class="historial" aria-labelledby="titulo-historial">
    <h3 id="titulo-historial">Historial de eventos</h3>
    <p class="historial__descripcion">
      Registro de creación y cambios de estado de esta reserva.
    </p>

    <ol class="timeline" id="historial-eventos">
      {% for evento in eventos %}
        <li class="timeline__evento">
          <div class="timeline__cabecera">
            <strong>{{ evento.tipo_evento|capitalize }}</strong>

            <time datetime="{{ evento.fecha_evento|date('Y-m-d\\TH:i:s') }}">
              {{ evento.fecha_evento|date('d/m/Y H:i') }}
            </time>
          </div>

          <p>{{ evento.descripcion }}</p>
        </li>
      {% else %}
        <li class="timeline__evento">
          <p>No hay eventos registrados para esta reserva.</p>
        </li>
      {% endfor %}
    </ol>
  </section>

  <div class="detalle-pie">
    <a class="enlace-volver" href="/">
      <span aria-hidden="true">←</span>
      Volver al listado
    </a>
  </div>
{% endblock %}
