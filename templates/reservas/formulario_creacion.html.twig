<section class="creacion" aria-labelledby="titulo-creacion">
  <h2 id="titulo-creacion">Nueva reserva</h2>

  <p>Los campos marcados con * son obligatorios.</p>

  <form id="formulario-creacion" class="formulario-creacion">
    <div>
      <label for="crear-nombre">Nombre del huésped *</label>
      <input
        type="text"
        id="crear-nombre"
        name="nombre_huesped"
        maxlength="120"
        autocomplete="name"
        required
      >
    </div>

    <div>
      <label for="crear-email">Email *</label>
      <input
        type="email"
        id="crear-email"
        name="email_huesped"
        maxlength="180"
        autocomplete="email"
        required
      >
    </div>

    <div>
      <label for="crear-alojamiento">Alojamiento *</label>
      <input
        type="text"
        id="crear-alojamiento"
        name="alojamiento"
        maxlength="120"
        required
      >
    </div>

    <div>
      <label for="crear-personas">Personas *</label>
      <input
        type="number"
        id="crear-personas"
        name="num_personas"
        min="1"
        step="1"
        required
      >
    </div>

    <div>
      <label for="crear-entrada">Fecha de entrada *</label>
      <input
        type="date"
        id="crear-entrada"
        name="fecha_entrada"
        min="{{ fecha_minima }}"
        required
      >
    </div>

    <div>
      <label for="crear-salida">Fecha de salida *</label>
      <input
        type="date"
        id="crear-salida"
        name="fecha_salida"
        required
      >
    </div>

    <div>
      <label for="crear-importe">Importe total (€) *</label>
      <input
        type="number"
        id="crear-importe"
        name="importe_total"
        min="0"
        step="0.01"
        required
      >
    </div>

    <div class="formulario-creacion__completo">
      <label for="crear-notas">Notas</label>
      <textarea
                id="crear-notas"
                name="notas"
                rows="3"
            ></textarea>
    </div>

    <div class="formulario-creacion__completo">
      <button type="submit" class="boton-crear">
        Crear reserva
      </button>
    </div>
  </form>

  <p
    id="mensaje-creacion"
    class="mensaje"
    role="status"
    aria-live="polite"
    hidden
  ></p>
</section>
