{% extends 'base.html.twig' %}

{% block titulo %}Listado de reservas{% endblock %}

{% block contenido %}
  
  <details class="panel-creacion">
    <summary class="panel-creacion__resumen">
      Crear nueva reserva
    </summary>

    {% include 'reservas/formulario_creacion.html.twig' %}
  </details>


  <section class="filtros">
    <h2>Filtrar reservas</h2>

    {# JavaScript captura el envío de este formulario para no recargar. #}
    <form id="formulario-filtros" class="formulario-filtros">
      <div>
        <label for="estado">Estado</label>
        <select id="estado" name="estado">
          <option value="">Todos</option>
          <option value="pendiente">Pendiente</option>
          <option value="confirmada">Confirmada</option>
          <option value="cancelada">Cancelada</option>
        </select>
      </div>

      <div>
        <label for="fecha_desde">Entrada desde</label>
        <input
          type="date"
          id="fecha_desde"
          name="fecha_desde"
        >
      </div>

      <div>
        <label for="fecha_hasta">Entrada hasta</label>
        <input
          type="date"
          id="fecha_hasta"
          name="fecha_hasta"
        >
      </div>

      <div>
        <label for="huesped">Huésped</label>
        <input
          type="search"
          id="huesped"
          name="huesped"
          maxlength="120"
          placeholder="Nombre del huésped"
        >
      </div>

      <button type="submit">Filtrar</button>

      <button type="button" id="limpiar-filtros">
        Limpiar
      </button>
    </form>
  </section>

  <section class="resultados">
    <h2>Reservas</h2>

    {# Aquí JavaScript muestra carga, número de resultados o errores. #}
    {# Empieza oculto y aparece cuando se realiza una búsqueda. #}
    <p
      id="mensaje"
      class="mensaje"
      role="status"
      aria-live="polite"
      hidden
    ></p>

    <table>
      <caption>Listado de reservas</caption>

      <thead>
        <tr>
          <th scope="col">Huésped</th>
          <th scope="col">Alojamiento</th>
          <th scope="col">Entrada</th>
          <th scope="col">Salida</th>
          <th scope="col">Personas</th>
          <th scope="col">Importe</th>
          <th scope="col">Estado</th>
          <th scope="col">Ver</th>
          <th scope="col">Gestionar</th>
        </tr>
      </thead>

      {# Twig pinta las filas iniciales; JavaScript las sustituye al filtrar. #}
      <tbody id="tabla-reservas">
        {% for reserva in reservas %}
          <tr data-reserva-id="{{ reserva.id }}">
            <td>{{ reserva.nombre_huesped }}</td>
            <td>{{ reserva.nombre_alojamiento }}</td>
            <td>{{ reserva.fecha_entrada|date('d/m/Y') }}</td>
            <td>{{ reserva.fecha_salida|date('d/m/Y') }}</td>
            <td>{{ reserva.num_personas }}</td>
            <td>
              {{ reserva.importe|number_format(2, ',', '.') }} €
            </td>
            <td>{{ reserva.estado|capitalize }}</td>
            <td>
              <a
                href="/reservas/{{ reserva.id }}"
                class="boton-detalle"
              >
                Ver detalle
              </a>
            </td>

            <td>
              <div class="acciones-reserva">
                {% if reserva.estado == 'pendiente' %}
                  <button
                    type="button"
                    class="boton-confirmar"
                    data-id="{{ reserva.id }}"
                  >
                    Confirmar
                  </button>

                  <button
                    type="button"
                    class="boton-cancelar"
                    data-id="{{ reserva.id }}"
                  >
                    Cancelar
                  </button>
                {% endif %}
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="9">
              No hay reservas que coincidan con los filtros.
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
{% endblock %}
