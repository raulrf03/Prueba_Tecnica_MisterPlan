<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <title>{% block titulo %}Reservas de alojamiento{% endblock %}</title>
    <link rel="stylesheet" href="/css/estilos.css">
  </head>
  <body>
    <header class="cabecera">
      <div class="cabecera__interior">
        <a class="marca" href="/" aria-label="Reservas de alojamiento: inicio">
          <span class="marca__icono" aria-hidden="true">R</span>

          <span class="marca__texto">
            <span class="marca__nombre">Reservas</span>
            <span class="marca__descripcion">Gestión de alojamientos</span>
          </span>
        </a>

        <nav class="navegacion" aria-label="Navegación principal">
          <a
            class="navegacion__enlace"
            href="/"
            {% if pagina_actual|default('') == 'listado' %}
            aria-current="page"
            {% endif %}
          >
            Listado de reservas
          </a>
        </nav>
      </div>
    </header>

    <main class="contenido">
      {% block contenido %}{% endblock %}
    </main>

    <script src="/js/reservas.js"></script>
  </body>
</html>
